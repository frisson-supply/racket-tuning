PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URL=postgresql://user:password@host:5432/database
# Opt-in only, for a throwaway local sandbox DB — leave unset for the
# shared dev/prod Supabase DBs, which are managed by migrations only.
# PAYLOAD_DB_PUSH=true

COMPANY_NAME="Racket Tuning"
# TWITTER_CREATOR="@payloadcms"
# TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="RacketTuning"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# S3
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_REGION=auto
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 bucket's "Public Development URL" (or custom domain) - used to generate public file URLs
S3_PUBLIC_URL=https://pub-<HASH>.r2.dev
